<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info definition for Scrim's own document type (SVG, PNG and JPEG are already in
     the system database). Installed to /usr/share/mime/packages/ (update-mime-database runs on
     install). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-figcraft">
    <comment>Scrim document</comment>
    <icon name="design.scrim.app"/>
    <glob pattern="*.figcraft"/>
  </mime-type>
</mime-info>
