    "file": {
      "format": "json",
      "paths": {"mac": ["{xdg_config}/devin/mcp_config.json"], "linux": ["{xdg_config}/devin/mcp_config.json"], "windows": ["{appdata}/devin/mcp_config.json"]},
      "documented": {"mac": true, "linux": true, "windows": true},
      "container": ["mcpServers"],
      "entry": {"url": "{url}"},
      "url_keys": ["url", "serverUrl"],
      "write": false
    },
    "notes": ["Devin's CLI documents no header option: with MCP authentication on, copy the entry instead."]
  },
  {
    "id": "windsurf",
    "name": "Windsurf (Devin Desktop)",
    "display": "Windsurf",
    "docs": ["https://docs.devin.ai/desktop/cascade/mcp", "https://docs.devin.ai/desktop/devin-desktop-faq"],
    "verified": "2026-10-21",
    "verification": "docs-only",
    "detect": {"programs": ["windsurf"], "dirs": ["{home}/.codeium"]},
    "snippet": {"format": "json", "value": {"mcpServers": {"{key}": {"serverUrl": "{url}"}}}, "token_set": {"headers": {"Authorization": "Bearer ${env:{token_var}}"}}},
    "notes": ["Windsurf is now Devin Desktop, and its documentation names four different places for this file, so Scrim doesn't write it. In the Cascade panel: ... (Actions) menu, then Open MCP config file, and add the entry under mcpServers."]
  },
  {
    "id": "amp",
    "name": "Amp",
    "display": "Amp",
    "docs": ["https://ampcode.com/docs/customize/mcp", "https://ampcode.com/docs/cli/settings"],
    "verified": "2026-10-21",
    "verification": "docs-only",
    "detect": {"programs": ["amp"], "dirs": ["{home}/.config/amp"]},
    "cli": {
      "program": "amp",
      "add": ["mcp", "add", "{key}", "{url}"],
      "remove": []
    },
    "file": {
      "format": "jsonc",
      "paths": {"mac": ["{home}/.config/amp/settings.json", "{home}/.config/amp/settings.jsonc"], "linux": ["{home}/.config/amp/settings.json", "{home}/.config/amp/settings.jsonc"], "windows": ["{home}/.config/amp/settings.json", "{home}/.config/amp/settings.jsonc"]},
      "documented": {"mac": true, "linux": true, "windows": true},
      "container": ["amp.mcpServers"],
      "entry": {"url": "{url}"},
      "url_keys": ["url"],
      "write": false
    },
    "notes": ["Amp's docs don't say which transport a url entry uses.", "Amp's CLI documents no header option for local servers: with MCP authentication on, copy the entry instead."]
  },
  {
    "id": "goose",
    "name": "Goose",
    "display": "Goose",
    "client_names": ["goose-cli", "goose-desktop"],
    "docs": ["https://goose-docs.ai/docs/guides/config-files", "https://goose-docs.ai/docs/getting-started/using-extensions"],
    "verified": "2026-10-21",
    "verification": "docs-only",
    "detect": {"programs": ["goose"], "dirs": ["{home}/.config/goose"]},
    "snippet": {"format": "yaml", "text": "extensions:\n  {key}:\n    type: streamable_http\n    name: {key}\n    enabled: true\n    uri: \"{url}\"\n    headers: {}\n    timeout: 300\n"},
    "notes": ["Goose adds servers interactively: goose configure, Add Extension, Remote Extension (Streamable HTTP). Its file is YAML (config.yaml), which Scrim doesn't edit."]
  },
  {
    "id": "continue",
    "name": "Continue",
    "display": "Continue",
    "client_names": ["continue-client"],
    "docs": ["https://docs.continue.dev/customize/deep-dives/mcp"],
    "verified": "2026-10-21",
    "verification": "docs-only",
    "detect": {"programs": [], "dirs": ["{home}/.continue"]},
    "snippet": {"format": "yaml", "text": "mcpServers:\n  - name: {key}\n    type: streamable-http\n    url: {url}\n"},
    "notes": ["Continue's configuration is YAML (~/.continue/config.yaml), which Scrim doesn't edit: add this under mcpServers."]
  },
  {
    "id": "lmstudio",
    "name": "LM Studio",
    "display": "LM Studio",
    "docs": ["https://lmstudio.ai/docs/app/mcp"],
    "verified": "2026-10-21",
    "verification": "docs-only",
    "detect": {"programs": [], "dirs": []},
    "snippet": {"format": "json", "value": {"mcpServers": {"{key}": {"url": "{url}"}}}},
    "notes": ["LM Studio edits its mcp.json in the app (Program tab, Install, Edit mcp.json); its docs don't say where the file is."]
  }
]
